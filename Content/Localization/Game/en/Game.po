#: Source/BrokenHorizon/Private/BHWarSubsystem.cpp(6534)
msgctxt "BrokenHorizon,RescueMissionBriefing"
msgid "A field operative requires urgent evacuation. Stabilize the casualty if necessary, move them by foot or vehicle, and deliver them to the friendly treatment point at {0}. The casualty cannot return to combat until treated."
msgstr "A field operative requires urgent evacuation. Stabilize the casualty if necessary, move them by foot or vehicle, and deliver them to the friendly treatment point at {0}. The casualty cannot return to combat until treated."

